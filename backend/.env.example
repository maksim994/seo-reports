APP_NAME="SEO Reports"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# После первого запуска: ./scripts/fix-app-key.sh
# APP_KEY должен быть в кавычках: APP_KEY="base64:..."

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=seo_reports
DB_USERNAME=seo_reports
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@seo-reports.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=seo-reports
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

FRONTEND_URL=http://localhost:5173

REPORT_API_CACHE_ENABLED=true
REPORT_API_CACHE_TTL=3600
TEMPLATE_LOGO_DISK=local

# Keys.so (мониторинг позиций)
KEYSSO_API_BASE_URL=https://api.keys.so
KEYSSO_RATE_LIMIT_MAX=10
KEYSSO_RATE_LIMIT_WINDOW=10

# Cursor Cloud Agents (технические SEO-аудиты)
CURSOR_API_KEY=
CURSOR_AUDIT_REPO_URL=https://github.com/maksim994/skills-seo-audit
CURSOR_AUDIT_REPO_REF=main
CURSOR_AUDIT_MODEL=composer-2.5
TECHNICAL_AUDIT_POLL_INTERVAL=30
TECHNICAL_AUDIT_POLL_MAX_ATTEMPTS=60
# Публичный URL для webhook из Cloud Agent (ngrok или prod). localhost не работает!
# TECHNICAL_AUDIT_WEBHOOK_BASE_URL=https://your-domain.com

# OAuth (Фаза 1) — заполните для подключения интеграций
# Для Вордстата в OAuth-приложении Яндекса добавьте scope wordstat:api
# и запросите доступ к API: https://wordstat.yandex.ru → Профиль → Доступ к API
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

VITE_APP_NAME="${APP_NAME}"
