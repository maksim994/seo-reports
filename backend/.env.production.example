# Production environment template for Coolify / docker-compose.prod.yml
# Copy values into Coolify Secrets or rename to .env on the server.
# Generate APP_KEY once: php artisan key:generate --show

APP_NAME="SEO Reports"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.com

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru

# Same domain as APP_URL when SPA is served from the web container
FRONTEND_URL=https://app.example.com

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=seo_reports
DB_USERNAME=seo_reports
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=app.example.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
REPORTS_STORAGE_DISK=s3
TEMPLATE_LOGO_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Object storage (Beget, Yandex Object Storage, AWS S3, MinIO)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru1
AWS_BUCKET=
AWS_ENDPOINT=https://s3.ru1.storage.beget.cloud
AWS_USE_PATH_STYLE_ENDPOINT=true
# Folder inside bucket: seo-report/reports/1/report.pdf
AWS_PREFIX=seo-report

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

REPORT_API_CACHE_ENABLED=true
REPORT_API_CACHE_TTL=3600

# Optional: run migrations on web container start (Coolify post-deploy is preferred)
RUN_MIGRATIONS=false

# web (default) | worker | scheduler — for Coolify v4 multi-container deploy
CONTAINER_ROLE=web

# Keys.so (position monitoring)
KEYSSO_API_BASE_URL=https://api.keys.so
KEYSSO_RATE_LIMIT_MAX=10
KEYSSO_RATE_LIMIT_WINDOW=10

# OAuth — register redirect URIs in provider consoles:
#   {APP_URL}/api/integrations/yandex_metrika/callback
#   {APP_URL}/api/integrations/yandex_webmaster/callback
#   {APP_URL}/api/integrations/google_analytics/callback
#   {APP_URL}/api/integrations/google_search_console/callback
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
